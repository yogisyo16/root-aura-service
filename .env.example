# Copy to .env and fill in the blanks: cp .env.example .env
# .env is gitignored — never commit it.

BINARY=mongoTodosYogis
DB_CONTAINER_NAME=mongodb-todos-yogis
MONGO_DB=todos_db
MONGO_DB_USERNAME=admin
MONGO_DB_PASSWORD=change-me
PORT=65510

# HS256 signing secret for JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=
